{
  "name": "aperture",
  "version": "1.0.0",
  "description": "Aperture Cassette Gateway — the 4-tier, memory-bounded plugin architecture from the Angel Armor legacy.",
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/",
    "bench": "npm run build && node bench/shed.js",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "plugin",
    "plugin-system",
    "express",
    "memory",
    "lazy-loading",
    "circuit-breaker"
  ],
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2"
  }
}
