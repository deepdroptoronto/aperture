{
  "name": "aperture",
  "version": "1.0.0",
  "description": "Aperture Cassette Gateway — the 4-tier, memory-bounded plugin architecture from the Angel Armor legacy.",
  "author": {
    "name": "DeepDrop Software Inc.",
    "email": "deepdropsoftware@gmail.com"
  },
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "bench": "npm run build && node bench/shed.js",
    "bench:flood": "npm run build && node bench/flood.js",
    "typecheck:ui": "tsc -p packages/angel-armor-ui/tsconfig.json",
    "smoke:ui": "tsc -p packages/angel-armor-ui/tsconfig.smoke.json && node dist/ui-smoke/smoke.js",
    "verify:ui": "npm run typecheck:ui && npm run smoke:ui",
    "export:ui": "node scripts/export-ui.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "plugin",
    "plugin-system",
    "express",
    "memory",
    "lazy-loading",
    "circuit-breaker"
  ],
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
