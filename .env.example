# Aperture Cassette Gateway — environment contract.
# Copy to .env (which is git-ignored) and adjust.
#
# This open-source engine needs NO third-party API keys. The harvey cassette shipped here is
# a deterministic mockup: no model calls, no network. If a .env in your tree
# contains OPENAI_API_KEY or similar, it belongs to a private build, not this one.

# HTTP port for the Platinum engine. Default: 3000
PORT=3000

# RSS budget in bytes, above which requests are shed with 503 "overloaded"
# BEFORE their bodies are parsed. Default: 224 MiB (234881024).
APERTURE_BUDGET_BYTES=234881024

# Maximum in-flight requests. Excess traffic is shed with 503 "overloaded".
# Default: 64
APERTURE_MAX_CONCURRENCY=64

# Bearer token for GET /stats and GET /__aperture/proof.
# Leave empty to disable both routes (they return 404). If set, requests must
# send: Authorization: Bearer <token>. Generate one with: openssl rand -hex 32
APERTURE_ADMIN_TOKEN=

# Per-client fairness (keyed by IP). A single client cannot take every slot.
# Concurrent admitted requests per client. 0 disables the slot limit. Default: 16
APERTURE_CLIENT_CONCURRENCY=16
# Sustained requests per second per client. 0 disables the rate limit. Default: 20
APERTURE_CLIENT_RATE=20
# Burst allowance per client. Default: 40
APERTURE_CLIENT_BURST=40

# Express "trust proxy" setting. Default: false (X-Forwarded-For is ignored).
# Behind a load balancer you control, set the hop count (e.g. 1) or a CIDR.
# Setting this while exposed directly lets clients spoof their IP and skip limits.
APERTURE_TRUST_PROXY=false

# --- Benchmark harness only (bench/flood.js) ---
# FLOOD_TOTAL=6000
# FLOOD_CONCURRENCY=100
# FLOOD_CAP=8
# FLOOD_DELAY_MS=5
